# ── Database ─────────────────────────────────────────────────────────────────
DB_SERVER=SERVICESCADA32\SQLEXPRESS
DB_DATABASE=Kalyan
DB_DRIVER=ODBC Driver 17 for SQL Server

# ── Application ──────────────────────────────────────────────────────────────
APP_ENV=production
APP_HOST=0.0.0.0
APP_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
VITE_API_URL=http://localhost:8000

# ── Plant configuration ──────────────────────────────────────────────────────
# Installed plant capacity in MW, used for every Performance Ratio calculation.
# Change per plant without touching code. For PR this should be the capacity the
# energy is referenced against (typically DC nameplate / kWp).
INSTALLED_CAPACITY_MW=130

# ── Scheduled-report e-mail ──────────────────────────────────────────────────
# Single pre-configured recipient for scheduled / test report e-mails (testing phase).
REPORT_RECIPIENT_EMAIL=ptshivaji8@gmail.com

# SMTP settings — REQUIRED to enable e-mail sending. Never commit real credentials.
# Gmail example (recommended for first setup):
#   1. Enable 2-Step Verification on the Google account.
#   2. Create an App Password: Google Account → Security → App passwords.
#   3. Use the 16-character App Password below as SMTP_PASSWORD (NOT your login password).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_gmail_address@gmail.com
SMTP_PASSWORD=your_16_char_app_password
SMTP_FROM_EMAIL=your_gmail_address@gmail.com

# ── API documentation exposure ────────────────────────────────────────────────
# Swagger /docs, /redoc and /openapi.json enumerate every route and schema. They are
# served automatically in development and disabled automatically when APP_ENV=production.
# Set explicitly to override either default.
# ENABLE_API_DOCS=false

# ── Report output location ────────────────────────────────────────────────────
# Root folder for on-disk report exports (one subfolder per report type is created
# inside it). Defaults to <Downloads>\Reports for the interactive user; set this to a
# fixed path when running as a service, whose Downloads folder is not what you expect.
# REPORTS_EXPORT_DIR=D:\KalyonReports

# ── Saved (Preconfigured) report templates ────────────────────────────────────
# Maximum number of saved templates that may exist at one time. Enforced by the
# API (POST /saved-reports returns 409 when full), not only by the UI. Editing,
# renaming and deleting existing templates are never affected. Defaults to 20.
# MAX_SAVED_TEMPLATES=20
