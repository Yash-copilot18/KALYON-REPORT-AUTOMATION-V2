# Frontend build-time configuration (Vite).
# Copy to `.env` (local) or `.env.production` (deployment) and set for your environment.
# Vite inlines VITE_* values AT BUILD TIME — rebuild after changing them, and never put
# a secret here: everything in this file ships to the browser.

# Base URL of the FastAPI backend, no trailing slash.
# REQUIRED in any deployment: without it the app falls back to http://localhost:8000,
# which silently breaks every request for users on other machines.
VITE_API_URL=http://localhost:8000
